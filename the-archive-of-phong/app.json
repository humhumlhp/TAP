{
  "expo": {
    "name": "the-archive-of-phong",
    "slug": "the-archive-of-phong",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/tap-prj.svg",
    "scheme": "thearchiveofphong",
    "font": {
      "VT323-Regular": "./assets/fonts/VT323-Regular.ttf"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "orientation": "portrait"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.humhumlhp.thearchiveofphong"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs access to your Camera."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd064ff1-df4c-4c40-8696-6845d1885e53"
      }
    },
    "owner": "humhumlhp"
  }
}
