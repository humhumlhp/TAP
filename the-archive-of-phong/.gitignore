# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Expo / Metro caches
.expo/
.expo-shared/
.metro-health-check*
.cache/
.expo/web/
.expo/cache/

# Build / output
dist/
web-build/
coverage/
build/
android/app/build/
ios/build/
ios/DerivedData/

# Generated / tooling
expo-env.d.ts
*.tsbuildinfo
.eslintcache
babel.config.js.map

# Platform folders (KEEP if you eject / use prebuild native mods)
# If you stay pure managed workflow you can ignore them:
ios/
android/

# Android / Gradle extras
android/.gradle/
android/.idea/
android/local.properties
android/captures/
*.jks
*.keystore

# iOS / CocoaPods
ios/Pods/
*.xcworkspace

# Security / signing
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*

# Env & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# (Keep an example:)
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
expo-error.log
*.log

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Temporary / misc
.tmp/
.sass-cache/
*.swp

# App sample
app-example/

# Kotlin cache (rare)
.kotlin/
